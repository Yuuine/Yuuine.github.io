<!DOCTYPE html>

<% if (config.language){ %>
<html lang="<%= config.language %>">
  <% } else { %>
  <html lang="en">
    <% }%>

    <head>
      <meta charset="utf-8" />
      <meta name="msvalidate.01" content="5B29A3E78C670AB4E4965896F49C7C8C" />
      <% var title = page.title; if (is_archive()) { title = __('archive_a'); if
      (is_month()) { title += ': ' + page.year + '/' + page.month; } else if
      (is_year()) { title += ': ' + page.year; } } else if (is_category()) {
      title = page.category; } else if (is_tag()) { title = __('tag') + ': ' +
      page.tag; } %> <% if (page.keywords){ %>
      <meta
        name="keywords"
        content="<%= page.keywords %>,<%= config.keywords %>"
      />
      <% } else if (config.keywords){ %>
      <meta name="keywords" content="<%= config.keywords %>" />
      <% } %> <% if (page.description){ %>
      <meta name="description" content="<%= page.description %>" />
      <% } else if (config.description){ %>
      <meta name="description" content="<%= config.description %>" />
      <% } %>
      <meta
        name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1"
      />

      <% var pageUrl = config.url + page.path; %>
      <% var ogImage = page.cover || theme.cover.enable ? config.url + (page.cover || theme.cover.path) : ''; %>

      <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>" />
      <meta property="og:title" content="<%= title ? title + ' | ' : '' %><%= config.title %>" />
      <meta property="og:description" content="<%= page.description || config.description || '' %>" />
      <meta property="og:url" content="<%= pageUrl %>" />
      <meta property="og:site_name" content="<%= config.title %>" />
      <% if (ogImage) { %>
      <meta property="og:image" content="<%= ogImage %>" />
      <% } %>

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="<%= title ? title + ' | ' : '' %><%= config.title %>" />
      <meta name="twitter:description" content="<%= page.description || config.description || '' %>" />
      <% if (ogImage) { %>
      <meta name="twitter:image" content="<%= ogImage %>" />
      <% } %>

      <link rel="canonical" href="<%= pageUrl %>" />

      <% if (is_post()) { %>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "<%= page.title %>",
        "author": {
          "@type": "Person",
          "name": "<%= config.author %>"
        },
        "datePublished": "<%= page.date.toISOString() %>",
        <% if (page.updated) { %>
        "dateModified": "<%= page.updated.toISOString() %>",
        <% } %>
        "url": "<%= pageUrl %>",
        <% if (ogImage) { %>
        "image": "<%= ogImage %>",
        <% } %>
        "publisher": {
          "@type": "Organization",
          "name": "<%= config.title %>",
          "url": "<%= config.url %>"
        }
      }
      </script>
      <% } else { %>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "<%= config.title %>",
        "url": "<%= config.url %>",
        "description": "<%= config.description || '' %>"
      }
      </script>
      <% } %>

      <title><% if (title){ %><%= title %> | <% } %> <%= config.title %></title>
      <% if (theme.favicon){ %>
      <link rel="icon" type="image/svg+xml" href="<%- theme.favicon %>" />
      <link rel="shortcut icon" href="/favicon.ico" />
      <% } %> <%- css('dist/main') %>
      <%- css('css/fonts/remixicon') %>
      <%- css('css/custom') %> <% if (theme.progressBar){ %>
      <script src="https://cdn.staticfile.org/pace/1.2.4/pace.min.js"></script>
      <% } %> <%- partial('google-analytics') %> <%- partial('baidu-analytics')
      %>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-bulma@5.0.1/bulma.min.css"
      />
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.js"></script>

      <!-- mermaid -->
      <% if (theme.mermaid.enable) { %>
      <script src="<%= theme.mermaid.cdn %>"></script>
      <% } %>
      <style>
        .swal2-styled.swal2-confirm {
          font-size: 1.6rem;
        }
      </style>
    </head>
  </html>
</html>
