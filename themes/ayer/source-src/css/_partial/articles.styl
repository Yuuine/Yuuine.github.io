// 文章卡片入场动画
@keyframes cardReveal
  0%
    opacity 0
    transform translateY(40px)
  100%
    opacity 1
    transform translateY(0)

.articles
  .article
    padding 4.5rem 0
    &:not(:last-child)
      border-bottom 1px solid #f0f0f0
  .article-entry
    margin-top 1rem
    padding 2rem 2.5rem
    border 1px solid #f0f0f0
    border-radius 12px
    background linear-gradient(135deg, #fff 0%, #fafbfc 100%)
    transition all .4s cubic-bezier(0.22, 1, 0.36, 1)
    position relative
    overflow hidden
    // scroll-reveal 入场动画
    opacity 0
    animation cardReveal .8s cubic-bezier(0.22, 1, 0.36, 1) forwards
    &:nth-child(1)
      animation-delay .1s
    &:nth-child(2)
      animation-delay .2s
    &:nth-child(3)
      animation-delay .3s
    &:nth-child(4)
      animation-delay .4s
    &:nth-child(5)
      animation-delay .5s
    // 左侧渐变装饰线
    &::before
      content ''
      position absolute
      top 0
      left 0
      width 3px
      height 0
      background linear-gradient(180deg, #00c4b6, #0681d0)
      border-radius 0 2px 2px 0
      transition height .4s cubic-bezier(0.22, 1, 0.36, 1)
    &:hover
      transform translateY(-4px)
      box-shadow 0 12px 40px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04)
      border-color #e8e8e8
      &::before
        height 100%
    .article-more-link
      display inline-block
      float right
      background-color #00c4b6
      padding .6rem 1.4rem
      border-radius 20px
      color white !important
      text-decoration none
      font-size .9rem
      font-weight 500
      letter-spacing 0.02em
      transition all .3s ease
      box-shadow 0 2px 8px rgba(0,196,182,0.3)
      &:hover
        background-color #00a89c
        transform translateY(-1px)
        box-shadow 0 4px 12px rgba(0,196,182,0.4)
    .article-gallery
      margin-top 1.5rem
  .article-footer
    margin-top 1rem
